{
  "name": "geosite2rule",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "RULE_CACHE",
      "id": "b34b8418e9e446d7a0450d233ecf0665"
    }
  ],
  "d1_databases": [
    {
      "binding": "RULE_DB",
      "database_name": "geosite2rule-cache",
      "database_id": "2092cfce-4da3-4a0e-9733-6bb70b188103"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SOURCE_URL": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat",
    "GEOIP_URL": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geoip.dat"
  }
}
