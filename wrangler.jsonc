{
  "name": "geosite2rule",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SOURCE_URL": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat",
    "GEOIP_URL": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat"
  }
}
